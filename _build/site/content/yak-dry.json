:19,"column":1}},"children":[{"type":"text","value":"🟡 Zipper flap is flappy","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"X3X3q12qRe"}],"key":"dkUOoQeOAb"}],"key":"p9uvCdeLbm"}],"key":"ImWxOVGvfu"},{"type":"heading","depth":2,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"VlwfpmcTNE"}],"identifier":"summary","label":"Summary","html_id":"summary","implicit":true,"key":"s16rctzt1J"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"I was super jealous of kayakers with hoods when I first bought this suit and realized it was made more for river kayakers. But I soon realized that having a hood in the wind quite literallyt blows and you never use the hoods anyway. The suit is duper durable with cordura in hard wearing areas. I found the latex neck seal to be very tight and had to cut several notches down to fit me (and I have a pretty skinny neck). It was so tight it felt like someone was choking me and I dreaded putting it on. Once I trimmed it, it was fine. Besides the neck the suit fits well. I found the shoulder zipper to be difficult to reach and close, but that became much easier with a few applications of ti-zip to lube it. The flap over the zipper also gets stuck up or the wind blows it up. Seems like this could be removed, or fixed with some double sided velcro.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"I8gcn5oFnu"}],"key":"TOhhqibeW9"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"This suit doesn’t breath as well as more expensive suits, but if you layer right, you can avoid excessive moisture build up on the inside. It dries very fast, even the booties. After 4 years of intensive the only sign of wear is in the ‘socks’ and I had to sew and patch the neoprene in the neck after tearing it. The socks after any use now are super wet and the breathing isn’t great for really wet outings. This suit is really good value for money, especially for your first suit when you’re trying things out and don’t want to spend a ton on new kit.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"THf3VWEHrP"}],"key":"jvbxPI6052"},{"type":"heading","depth":2,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Buyer","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"VNHNKifFNn"}],"identifier":"buyer","label":"Buyer","html_id":"buyer","implicit":true,"key":"CWjX2QYJBB"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Entry level kayakers that need a drysuit but don’t want to spend >£600 to get going.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"uhlFkBvCV5"}],"key":"O2RdkDJ6vc"},{"type":"heading","depth":2,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Specs","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"drHBJUugJ9"}],"identifier":"specs","label":"Specs","html_id":"specs","implicit":true,"key":"CHR5hphsBn"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Cost: RRP £645 but Escape has it at £299.99 during the writing of this review.","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"eWfB2EMOvB"}],"key":"FX2EoRDnwh"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Weight:","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"hQ9InF