olumn":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"🟡 Can be challenging to paddle in cross-winds","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"jOsnwfMpiE"}],"key":"L7vrX8dwYn"}],"key":"WNiBLxtu7W"}],"key":"XoQVs1DrOR"},{"type":"heading","depth":2,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"SojXIY82lg"}],"identifier":"summary","label":"Summary","html_id":"summary","implicit":true,"key":"Ha12VTeQ8n"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"The P&H Valkyrie is an exceptionally speedy plastic boat that mimics a surfski hull design. The boat also surfs downwind very well, although coordinating rudder, paddle, and edging takes some coordination at first. If you use the boat in surf or downwind conditions a lot, it helps to reverse the rudder so that pushing on the left turns right. That way when you’re carving to the left you also rudder left. However, I’ve found that it’s easier just to carve and rudder with paddle rather than using the rudder which tends to overturn. It’s also worth adding some bungees in the ruddering mechanism in the rear to make the rudder return to straight and track straight w/o touching the pedal controls.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"jt2mSlOxRA"}],"key":"BVt1ADce29"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"For how narrow and long this boat is (~5.4 m) it handles exceptionally well in rough conditions, although because it’s long it can windcock a lot or is difficult to turn in windy conditions. Despite the high front deck height, the boat is exceptionally easy to roll.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"Y70OLCD4n1"}],"key":"ItytOk5giq"},{"type":"heading","depth":2,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Buyer","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"HTqjBVQ05u"}],"identifier":"buyer","label":"Buyer","html_id":"buyer","implicit":true,"key":"lhmAJ1AmCT"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Speedy expeditioner or circumnavigator who doesn’t want to faff with carbon or glass boats.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"dbSk8Wxy5x"}],"key":"pMQAHm1FAj"},{"type":"heading","depth":2,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Specs","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"L1CvtxIqN0"}],"identifier":"specs","label":"Specs","html_id":"specs","implicit":true,"key":"PjJQidS6gV"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Cost:","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"ZZrNeB3HfQ"}],"key":"hRhupNCd25"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Weight:","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"GGRKXWHqa2"}],"key":"E2CRlGBB3J"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"URL:","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"eyy4BgrDXR"}],"key":"K3AHiuAw3g"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Review date: DD Month Year","position":{"start":{"line