olumn":1}},"children":[{"type":"text","value":"🟡 Headband adjustment is fiddly","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"Dgn8foIJvp"}],"key":"V6eCk2LwvV"}],"key":"I6Gqf0BAwV"}],"key":"uytX3yqM9g"},{"type":"heading","depth":2,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"mvQmSJUxVp"}],"identifier":"summary","label":"Summary","html_id":"summary","implicit":true,"key":"MdrBMT7etq"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"This helmet just looks cool, plus you get a visor to keep the sun out. I’m not sure whether to start singing Kiss’s Strutter or Sweet’s Ballroom Blitz when I put this helmet on but it does make you want to go out and surf some waves, run a tiderace, or negotiate splosh. Altho, generally pricey, you can often get them on sale. Not too long ago, Escape Watersports had a neon green Strutter for sale at £49.99.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"CeKTQno5rI"}],"key":"n1nUaMmhFg"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"I found the headband to be uncomfortable at first after about 1 hr of paddling. This has gradually subsided and I’m not sure whether I broke in the helmet or it broke me in. On longer paddles, I do often have to do a little hat adjustment to move it around. This could be fixed, perhaps by wearing a headband or thin beanie underneath. For example, I noticed that when wearing a neoprene balaclava on colder days, this issue did not persist. Adjusting the headband on the fly is not easy and could easily be replaced by BOA dial or similar easy to adjust feature like on bike helmets.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"M0w0ZTdyKc"}],"key":"EQBPPjMa1U"},{"type":"heading","depth":2,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Buyer","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"eLaQOMxOF6"}],"identifier":"buyer","label":"Buyer","html_id":"buyer","implicit":true,"key":"d63HVenGtO"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Anyone going rockhopping, into waves or more advanced conditionsl","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"ZLTbq9rw8y"}],"key":"BFVVC0WVdC"},{"type":"heading","depth":2,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Specs","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"yx1m7i4emW"}],"identifier":"specs","label":"Specs","html_id":"specs","implicit":true,"key":"Z1rEZMWbje"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Cost: £180","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"IWQ4qr5441"}],"key":"HUD9lSPIx6"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Review date: 2 March 2026","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"dcRq5rNJDh"}],"key":"OMC0RzZeks"}],"key":"ip8B5K8Knn"}],"key":"p0Tw35o0Vq"},"references":{"cite":{"order":[],"data":{}}}}