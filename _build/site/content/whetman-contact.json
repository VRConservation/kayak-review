n":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"🟡 Reproduce with climbing gear?","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"fejHyOMjgn"}],"key":"CTbQ8WIusl"}],"key":"rOvz2Lk5ls"}],"key":"hhfpWjxBKO"},{"type":"heading","depth":2,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"jH8YGTgs9n"}],"identifier":"summary","label":"Summary","html_id":"summary","implicit":true,"key":"oESPPL3u9x"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"I have to admit I have a love/hate relationship with the Whetman Sea Contact Tow MK11. While paddline, it has the tendency to unravel or come undone from it’s origami-like stow setup and the miserly amount of velcro used to secure it doesn’t help. However, the carabiners and quick deployment make it easy to use when it’s needed. It’s also highly adjustable so usable on multiple boats. This contact tow would be perfect if the folding up/stowage was improved substantially.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"Z4NPyRFCvX"}],"key":"AVcp6tG9Qn"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Before puchasing this unit, I made contact tows with climbing equipment and rope, but went through a number of carabiners that froze after saltwater contact or that weren’t the right shape for easy deployment. None of them had a quick release toggle, but that would have been easy to add. Finding the right pieces will make a more customized, and perhaps more stowable contact tow, but how much time and money do you spend on that before getting it right?","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"JN5Fd6cGLR"}],"k